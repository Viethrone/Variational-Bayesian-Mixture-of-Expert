# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/
env/
ENV/

# Data: only data/splits/*.txt (small, reproducible) is committed.
# Everything that can be regenerated by tools/preprocess/run_preprocess.py is excluded.
data/raw/**
!data/raw/**/
!data/raw/**/.gitkeep
data/interim/*
data/processed/*
data/external/*
!data/interim/.gitkeep
!data/processed/.gitkeep
!data/external/.gitkeep

# Large array / weight formats (use --set data.files.seismic=... and regenerate instead)
*.npy
*.npz
*.h5
*.hdf5
*.nc
*.tif
*.tiff
*.mat
*.parquet
*.pkl
*.pickle
*.zip
*.tar
*.tar.gz
*.ckpt
*.pt
*.pth
*.safetensors
*.onnx

# Experiment outputs (regenerate by running the commands in README.md)
outputs/**
!outputs/**/
!outputs/**/.gitkeep
figures/*
!figures/**/
!figures/**/.gitkeep

# Editors / OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Sensitive info
.env
.env.*
!.env.example
*.key
*.pem
secrets.yaml
wandb/
